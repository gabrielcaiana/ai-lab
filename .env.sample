## PROJECT CONFIGURATION
NUXT_PUBLIC_APP_ENV="production"
NUXT_PUBLIC_BASE_UR="/api"

## AI PROVIDERS (optional — keys can also be set in the UI)
NUXT_OPENAI_API_KEY=""
NUXT_ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
## CLOUDFLARE
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_NAMESPACE_ID=
NUXT_CLOUDFLARE_API_TOKEN=

# Local Postgres from `docker compose up -d` (see docker-compose.yml).
# Prisma reads both. Locally they are identical; a remote pooler (Supabase)
# uses the pooled URL here and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ailab"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ailab"